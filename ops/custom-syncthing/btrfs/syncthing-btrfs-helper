#!/bin/bash
# Root helper for syncthing btrfs scan replay (v5, primitive operations).
# Called via the socket adapter (one connection per request). Snapshot names
# are restricted to [a-z0-9.-].
#   snap <name>           - read-only snapshot of the subvolume as <name>
#   diff <a> <b>          - print btrfs send --no-data -p <a> <b> | receive --dump
#   setbaseline <name>    - make snapshot <name> the baseline (deletes old)
#   rmsnap <name>         - delete snapshot <name> (never the baseline); a
#                           missing snapshot is success (idempotent). A
#                           send still reading <name> is killed first and
#                           waited for; then prints cancelled-send-exit=<s>
#   status                - print baseline=<path|none>
#   subvol                - print subvol=<mount path>
#   subvols               - list nested subvolumes by path
#   version               - print helper-version=N (drift detection via the
#                           socket, no root needed)
#
# v5 (2026-11-26): rmsnap cancels a diff still reading the snapshot. The
# client gives up on a slow diff by closing its connection, but send writes
# to a temp file, never to the socket, so it ran on: on yarlung 2026-11-25
# a diff-baseline outlived its client by 5 min and the client's rmsnap got
# EPERM ("attempt to delete subvolume 2047 during send"). rmsnap now
# SIGKILLs any send whose child snapshot is <name>, waits for it to exit
# (measured 1.8 s cached, 50-60 s on a disk-bound send: the kernel only
# notices the signal at its next stream write), then deletes. Both diff
# and rmsnap log one line with their cost to the journal.
#
# v4 (2026-10-21): rmsnap made truly idempotent — the old `[ -d x ] && delete`
# trailing test exited 1 when x was absent, which turned every successful
# pairing's deferred cleanup into a false-failure WRN (setbaseline renames
# the staging snapshot to baseline, so the name is legitimately gone by then).
# Added the version verb.
#
# v3 (2026-10-15): diff/diff-baseline no longer pipe send directly into
# receive --dump. On streams larger than the pipe buffer, receive exits
# after the final command while the kernel still has a write in flight;
# send then dies with SIGPIPE/EPIPE (pipeline exit 141/32) despite a
# complete stream. The temp file decouples the two. Streams are ~2MB.
set -euo pipefail
SUB=/home
# STBTRFS_HELPER_DIR exists for the helper's own tests; the socket unit
# sets no environment, so the installed helper always uses the default.
DIR=${STBTRFS_HELPER_DIR:-/home/.snapshots/syncthing}
BASE=$DIR/baseline

mkdir -p "$DIR"

name_ok() { [[ "${1:-}" =~ ^[a-z0-9.-]+$ ]] && [[ "$1" != "baseline" ]]; }

now() { date +%s.%N; }
since() { awk -v a="$1" -v b="$(now)" 'BEGIN { printf "%.3f", b - a }'; }
readbytes() { awk '/^read_bytes:/ { print $2 }' /proc/$$/io 2>/dev/null || echo 0; }

dump_diff() { # dump_diff <parent> <child>
    local stream t0 r0 rc=0
    stream=$(mktemp)
    trap "rm -f \"$stream\"" EXIT
    t0=$(now) r0=$(readbytes)
    # Reaped children's IO accrues to this shell, so the read_bytes delta
    # is send's metadata reads.
    btrfs send --no-data -p "$1" "$2" > "$stream" || rc=$?
    echo "diff ${2##*/}: send took=$(since "$t0")s streamBytes=$(stat -c %s "$stream") readBytes=$(( $(readbytes) - r0 )) rc=$rc" >&2
    [ "$rc" = 0 ] || exit "$rc"
    btrfs receive --dump < "$stream"
}

# cancel_send <name>: SIGKILL any send whose child snapshot is $DIR/<name>
# and wait until it has exited; btrfs refuses to delete a snapshot that a
# send is reading.
cancel_send() {
    local pat="send --no-data -p .* $DIR/$1\$" t0
    pgrep -f "$pat" >/dev/null || return 0
    t0=$(now)
    pkill -KILL -f "$pat" || true
    while pgrep -f "$pat" >/dev/null; do sleep 0.2; done
    local took
    took=$(since "$t0")
    echo "rmsnap $1: cancelled running send, exited after ${took}s" >&2
    echo "cancelled-send-exit=$took"
}

case "${1:-}" in
  snap)
    name_ok "${2:-}" || { echo "bad name" >&2; exit 2; }
    btrfs subvolume snapshot -r "$SUB" "$DIR/$2" >/dev/null
    echo "snap=$DIR/$2"
    ;;
  diff)
    name_ok "${2:-}" && name_ok "${3:-}" || { echo "bad name" >&2; exit 2; }
    [ -d "$DIR/$2" ] && [ -d "$DIR/$3" ] || { echo "snapshot missing" >&2; exit 1; }
    dump_diff "$DIR/$2" "$DIR/$3"
    ;;
  diff-baseline)
    name_ok "${2:-}" || { echo "bad name" >&2; exit 2; }
    [ -d "$BASE" ] || { echo "no baseline snapshot" >&2; exit 1; }
    [ -d "$DIR/$2" ] || { echo "snapshot missing" >&2; exit 1; }
    dump_diff "$BASE" "$DIR/$2"
    ;;
  setbaseline)
    name_ok "${2:-}" || { echo "bad name" >&2; exit 2; }
    [ -d "$DIR/$2" ] || { echo "snapshot missing" >&2; exit 1; }
    [ -d "$BASE" ] && btrfs subvolume delete "$BASE" >/dev/null
    mv "$DIR/$2" "$BASE"
    echo "baseline=$BASE"
    ;;
  rmsnap)
    name_ok "${2:-}" || { echo "bad name" >&2; exit 2; }
    cancel_send "$2"
    # Idempotent: a missing snapshot is success, and the trailing test must
    # not decide the script's exit status (`[ -d x ] && cmd` yields 1 when
    # x is absent).
    if [ -d "$DIR/$2" ]; then btrfs subvolume delete "$DIR/$2" >/dev/null; fi
    ;;
  status)
    if [ -d "$BASE" ]; then echo "baseline=$BASE"; else echo "baseline=none"; fi
    ;;
  subvol)
    echo "subvol=$SUB"
    ;;
  subvols)
    btrfs subvolume list -o "$SUB" | sed "s:.*path ::"
    ;;
  version)
    echo "helper-version=5"
    ;;
  *)
    echo "usage: $0 snap|diff|diff-baseline|setbaseline|rmsnap|status|subvol|subvols|version" >&2; exit 2
    ;;
esac
